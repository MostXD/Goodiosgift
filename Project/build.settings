-- build.settings
settings =
{
    orientation =
    {
        default = "portrait",
        supported = { "portrait" },
    },
    
    android =
    {
        usesPermissions =
        {
            "android.permission.INTERNET",
            "android.permission.ACCESS_NETWORK_STATE"
        },
        -- ПРИНУДИТЕЛЬНО СТАВИМ ANDROID 10 (API 29)
        targetSdkVersion = "29", 
        minSdkVersion = "22",
    },
    
    iphone =
    {
        plist =
        {
            NSAppTransportSecurity = { NSAllowsArbitraryLoads = true },
        },
    },
}
